{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
                "args": [
                    "build",
                    "${workspaceFolder}/PakuPaku/PakuPaku.csproj"
                ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$csharp",
            "presentation": {
                "reveal": "silent",
                "clear": true
            },
            "detail": "dotnet build PakuPaku"
        },
        {
            "label": "restore",
            "type": "process",
            "command": "dotnet",
            "args": ["restore"],
            "problemMatcher": "$msbuild",
            "presentation": {
                "reveal": "silent",
                "clear": true
            },
            "detail": "dotnet restore"
        },
        {
            "label": "run",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/PakuPaku/PakuPaku.csproj",
                "--no-build"
            ],
            "dependsOn": "build",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$csharp",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "dotnet run PakuPaku"
        }
    ]
}
